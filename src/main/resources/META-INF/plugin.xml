<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>io.github.skieylion.plumb</id>
    <name>Plumb</name>
    <vendor url="https://github.com/skieylion">skieylion</vendor>
    <description><![CDATA[
        <p>Precise code facts for AI coding agents: metrics, thresholds and verdicts from IntelliJ PSI, served over MCP.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.java</depends>
    <depends>com.intellij.mcpServer</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Plumb" displayType="BALLOON"/>
    </extensions>

    <extensions defaultExtensionNs="com.intellij.mcpServer">
        <mcpToolset implementation="io.github.skieylion.plumb.mcp.PlumbMcpToolset"/>
    </extensions>

    <actions>
        <action id="Plumb.CalculateComplexity"
                class="io.github.skieylion.plumb.idea.CalculateComplexityAction"
                text="Plumb: Calculate CC"
                description="Measure cyclomatic complexity of every Java method in the project">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
